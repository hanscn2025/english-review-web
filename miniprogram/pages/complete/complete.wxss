.complete { padding: 220rpx 48rpx calc(64rpx + env(safe-area-inset-bottom)); text-align: center; display: flex; flex-direction: column; align-items: center; }
.done { width: 128rpx; height: 128rpx; margin: 0 auto 40rpx; border-radius: 64rpx; background: var(--blue-soft); color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 64rpx; font-weight: 700; }
.done image { width: 54rpx; height: 54rpx; }
.complete .title { margin-top: 12rpx; font-size: 56rpx; }
.summary-grid { width: 100%; margin-top: 56rpx; padding: 28rpx 0; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); display: grid; grid-template-columns: repeat(3, 1fr); }
.summary-grid view { display: flex; flex-direction: column; gap: 8rpx; }
.summary-grid view + view { border-left: 1rpx solid var(--line); }
.summary-grid text:first-child { color: var(--ink); font-size: 38rpx; line-height: 48rpx; font-weight: 700; }
.summary-grid text:last-child { color: var(--muted); font-size: 24rpx; line-height: 34rpx; }
.next-review { width: 100%; box-sizing: border-box; margin: 20rpx 0 32rpx; padding: 24rpx 28rpx; border-radius: 24rpx; background: var(--blue-soft); display: flex; justify-content: space-between; color: var(--muted); font-size: 25rpx; }
.next-review text:last-child { color: var(--blue); font-weight: 700; }
.complete button { width: 100%; }
.history-button { min-height: 88rpx; margin-top: 12rpx; background: transparent; color: var(--blue); font-size: 27rpx; font-weight: 600; }
