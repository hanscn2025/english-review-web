<view class="page form-page">
  <view class="mini-topbar"><view class="bar-side"><button bindtap="goBack" aria-label="返回"><image src="/assets/icons/back.svg" /></button></view><view class="bar-title">{{id ? '编辑内容' : '添加内容'}}</view><view class="bar-side"></view></view>
  <view class="field type-field"><text class="field-label">内容类型</text><view class="type-switch"><button wx:for="{{types}}" wx:key="*this" class="{{typeIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectType">{{item}}</button></view></view>
  <view class="field">
    <view class="field-heading">
      <text class="field-label">英文</text>
      <button wx:if="{{english}}" class="speaker {{speaking ? 'playing' : ''}}" bindtap="playEnglish" disabled="{{speaking}}" aria-label="试听英文发音">
        <image src="/assets/icons/volume-up.svg" mode="aspectFit" />
      </button>
    </view>
    <textarea class="textarea english" auto-height placeholder="输入单词、词组或完整句子" placeholder-style="font-size:28rpx;font-weight:400;color:#8a94a3;line-height:1.5" value="{{english}}" data-field="english" bindinput="field" bindblur="completeEnglish" maxlength="500" />
    <view wx:if="{{completing}}" class="field-message">正在完善中文和音标…</view>
    <button wx:if="{{completeError}}" class="field-message error retry-message" bindtap="retryComplete">{{completeError}}</button>
    <view wx:if="{{speechError}}" class="field-message error">{{speechError}}</view>
  </view>
  <view class="field"><text class="field-label">中文意思</text><textarea class="textarea meaning" auto-height placeholder="输入英文后自动完善，也可以手动修改" placeholder-style="font-size:28rpx;font-weight:400;color:#8a94a3;line-height:1.5" value="{{meaning}}" data-field="meaning" bindinput="field" maxlength="500" /></view>
  <view class="field"><text class="field-label">所属词书</text><button class="picker picker-button" bindtap="openBookPicker"><text>{{bookNames[bookIndex] || '请选择词书'}}</text><image class="row-icon" src="/assets/icons/chevron-right.svg" /></button></view>
  <button class="advanced-toggle" bindtap="toggleAdvanced"><text>补充信息（选填）</text><text>{{showAdvanced ? '收起' : '展开'}}</text></button>
  <view wx:if="{{showAdvanced}}" class="advanced-fields">
    <view class="field" wx:if="{{typeValues[typeIndex] !== 'sentence'}}"><text class="field-label">音标</text><input class="input" placeholder="例如 /ˈklerəfaɪ/" placeholder-style="font-size:28rpx;font-weight:400;color:#8a94a3" value="{{ipa}}" data-field="ipa" bindinput="field" /></view>
    <view class="field"><text class="field-label">英语例句</text><textarea class="textarea example" auto-height placeholder="保留遇见它时的真实语境" placeholder-style="font-size:28rpx;font-weight:400;color:#8a94a3;line-height:1.5" value="{{exampleEn}}" data-field="exampleEn" bindinput="field" bindblur="completeExample" maxlength="500" /></view>
    <view class="field"><text class="field-label">例句翻译</text><textarea class="textarea example" auto-height placeholder="例句的中文意思" placeholder-style="font-size:28rpx;font-weight:400;color:#8a94a3;line-height:1.5" value="{{exampleZh}}" data-field="exampleZh" bindinput="field" maxlength="500" /></view>
  </view>
  <view class="save-space"></view>
</view>

<view class="save-dock"><button class="primary save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存到词书</button></view>

<view wx:if="{{bookPickerOpen}}" class="sheet-mask" bindtap="closeBookPicker"></view>
<view wx:if="{{bookPickerOpen}}" class="book-sheet">
  <view class="sheet-bar"><button bindtap="closeBookPicker">取消</button><text>选择词书</text><button bindtap="confirmBook">确定</button></view>
  <scroll-view class="sheet-list" scroll-y>
    <button wx:for="{{books}}" wx:key="_id" class="sheet-row {{pendingBookIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectBook"><text>{{item.name}}</text><text wx:if="{{pendingBookIndex === index}}" class="selected-label">已选</text></button>
    <button wx:if="{{!addingBook}}" class="sheet-row new-book" bindtap="startNewBook">新建词书</button>
    <view wx:else class="new-book-form"><input placeholder="输入词书名称" value="{{newBookName}}" bindinput="inputNewBookName" focus /><button bindtap="createBook">创建</button></view>
  </scroll-view>
</view>
