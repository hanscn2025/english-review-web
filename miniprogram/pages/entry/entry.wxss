.form-page { padding: 8rpx 48rpx calc(56rpx + env(safe-area-inset-bottom)); }
.field { margin-top: 32rpx; }
.type-field { margin-top: 24rpx; }
.type-field .field-label { margin-bottom: 16rpx; }
.type-switch { width: 100%; box-sizing: border-box; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 6rpx; border-radius: 24rpx; background: var(--surface); overflow: hidden; }
.type-switch button { width: 100% !important; min-width: 0; height: 88rpx; min-height: 88rpx; padding: 0; border-radius: 19rpx; background: transparent; color: #667085; font-size: 27rpx; font-weight: 700; line-height: 1; display: flex; align-items: center; justify-content: center; }
.type-switch button.selected { background: var(--blue); color: #fff; box-shadow: none; }
.field-heading { min-height: 54rpx; display: flex; align-items: center; justify-content: space-between; }
.field-heading .field-label { margin-bottom: 0; }
.text-action { margin: 0; padding: 4rpx 0 12rpx 24rpx; background: transparent; color: #0969ed; font-size: 26rpx; line-height: 1.4; }
.text-action::after { border: 0; }
.textarea { min-height: 104rpx; padding: 24rpx 28rpx; border-radius: 24rpx; line-height: 1.5; }
.english { min-height: 104rpx; font-size: 30rpx; font-weight: 400; }
.meaning { min-height: 152rpx; font-weight: 400; }
.example { min-height: 128rpx; }
.speaker { width: 64rpx; height: 54rpx; padding: 8rpx 0 12rpx 18rpx; background: transparent; display: flex; align-items: center; justify-content: flex-end; }
.speaker image { width: 36rpx; height: 36rpx; }
.speaker[disabled] { opacity: .5; }
.picker-button { width: 100% !important; min-width: 0; max-width: none; min-height: 96rpx; padding: 0 28rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: space-between; color: var(--ink); text-align: left; line-height: 1.45; }
.chevron { color: #7b8798; font-size: 38rpx; }
.field-message { margin-top: 12rpx; color: #7b8798; font-size: 24rpx; line-height: 1.5; }
.field-message.error { color: #b54732; }
.retry-message { width: 100%; padding: 0; background: transparent; text-align: left; }
.retry-message::after { border: 0; }
.advanced-toggle { width: 100%; min-height: 88rpx; margin-top: 28rpx; padding: 0; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); border-radius: 0; background: transparent; color: var(--text); font-size: 27rpx; display: flex; align-items: center; justify-content: space-between; }
.advanced-toggle text:last-child { color: var(--blue); font-size: 25rpx; }
.save-space { height: 152rpx; }
.save-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 20rpx 48rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255,255,255,.96); }
.save { width: 100% !important; min-width: 0; max-width: none; border-radius: 24rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 20; background: rgba(19,32,51,.42); }
.book-sheet { position: fixed; left: 20rpx; right: 20rpx; bottom: 0; z-index: 21; padding-bottom: env(safe-area-inset-bottom); border-radius: 32rpx 32rpx 0 0; background: #fff; overflow: hidden; }
.sheet-bar { height: 104rpx; padding: 0 28rpx; border-bottom: 1rpx solid #e8edf3; display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: center; }
.sheet-bar text { color: #111827; font-size: 30rpx; font-weight: 700; }
.sheet-bar text { text-align: center; }
.sheet-bar button { width: 100% !important; height: 104rpx; padding: 0; background: transparent; color: var(--blue); font-size: 28rpx; line-height: 40rpx; display: flex; align-items: center; }
.sheet-bar button:last-child { justify-content: flex-end; text-align: right; }
.sheet-bar button:first-child { justify-content: flex-start; text-align: left; }
.sheet-bar button:first-child { color: #7b8798; }
.sheet-list { max-height: 560rpx; }
.sheet-row { width: 100% !important; min-height: 104rpx; padding: 0 32rpx; border-bottom: 1rpx solid var(--line); background: #fff; color: var(--text); font-size: 28rpx; line-height: 40rpx; display: flex; align-items: center; justify-content: space-between; text-align: left; }
.sheet-row.selected { background: #f4f8ff; color: #0969ed; }
.selected-label { font-size: 24rpx; }
.new-book { color: #0969ed; }
.new-book-form { padding: 24rpx 32rpx; display: flex; gap: 20rpx; }
.new-book-form input { flex: 1; height: 84rpx; padding: 0 22rpx; border: 1rpx solid #dce3ec; border-radius: 18rpx; color: #132033; }
.new-book-form button { width: 124rpx; height: 84rpx; background: #0969ed; color: #fff; font-size: 27rpx; }
