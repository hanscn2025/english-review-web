<view class="page account">
  <view class="mini-topbar"><view class="bar-side"></view><view class="bar-title">我的</view><view class="bar-side"></view></view>

  <view class="profile-card">
    <view class="avatar">{{account ? 'D' : '微'}}</view>
    <view class="profile-copy" wx:if="{{account}}">
      <text>{{account.nickname}}</text>
      <text>{{account.accountId}} · 微信云端账号</text>
    </view>
    <view class="profile-copy" wx:else>
      <text>登录 Dayword</text>
      <text>同步个人词书与学习记录</text>
    </view>
    <button wx:if="{{!account}}" class="login-button" bindtap="login" loading="{{loggingIn}}" disabled="{{loading || loggingIn}}">微信登录</button>
    <view wx:else class="signed-badge">已登录</view>
  </view>

  <view class="account-error" wx:if="{{error}}">{{error}}</view>

  <view class="stats">
    <view><text>{{entryCount}}</text><text>已收录</text></view>
    <view><text>{{reviewCount}}</text><text>已复习</text></view>
    <view><text>{{checkInCount}}</text><text>打卡天数</text></view>
  </view>

  <view class="section-label">学习与数据</view>
  <view class="menu-card">
    <button bindtap="openBooks"><view class="menu-icon blue"><image src="/assets/icons/book.svg" /></view><view class="menu-copy"><text>我的词书</text><text>{{bookCount}} 本词书 · {{entryCount}} 条内容</text></view><image class="menu-arrow" src="/assets/icons/chevron-right.svg" /></button>
    <button bindtap="openReviews"><view class="menu-icon apricot"><image src="/assets/icons/history.svg" /></view><view class="menu-copy"><text>复习记录</text><text>查看已复习内容与自由复习</text></view><image class="menu-arrow" src="/assets/icons/chevron-right.svg" /></button>
    <button bindtap="openTranslate"><view class="menu-icon blue"><image src="/assets/icons/translate.svg" /></view><view class="menu-copy"><text>在线翻译</text><text>文字与拍照识别翻译</text></view><image class="menu-arrow" src="/assets/icons/chevron-right.svg" /></button>
    <button bindtap="showDataInfo"><view class="menu-icon neutral"><image src="/assets/icons/settings.svg" /></view><view class="menu-copy"><text>账号与数据</text><text>了解云端同步和账号隔离</text></view><image class="menu-arrow" src="/assets/icons/chevron-right.svg" /></button>
  </view>

  <view class="service-note"><text>复习间隔</text><text>1 · 3 · 7 · 14 · 30 天</text></view>
</view>
