.today { padding: 0 48rpx 48rpx; }
.safe-top { height: 188rpx; }
.today-heading { display: flex; align-items: center; justify-content: space-between; }
.today-heading .title { font-size: 48rpx; letter-spacing: -1rpx; }
.cloud-warning { margin-top: 28rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #fff4e8; color: #9a5614; font-size: 25rpx; line-height: 1.5; }
.review-panel { margin-top: 40rpx; min-height: 304rpx; box-sizing: border-box; padding: 32rpx 36rpx 0; border-radius: 32rpx; background: var(--blue); color: #fff; }
.review-main { display: flex; align-items: center; justify-content: space-between; }
.panel-label { font-size: 24rpx; line-height: 34rpx; opacity: .78; }
.review-count { margin: 8rpx 0 4rpx; font-size: 32rpx; line-height: 72rpx; font-weight: 600; }
.review-count text { font-size: 72rpx; font-weight: 700; letter-spacing: -2rpx; }
.review-panel .muted { color: rgba(255,255,255,.72); font-size: 24rpx; line-height: 34rpx; }
.start { flex: 0 0 auto; width: 176rpx !important; height: 72rpx; padding: 0 24rpx; border-radius: 20rpx; background: #fff; color: var(--blue); font-size: 25rpx; line-height: 72rpx; font-weight: 700; }
.review-done { flex: 0 0 auto; height: 56rpx; box-sizing: border-box; padding: 0 22rpx; border-radius: 28rpx; background: rgba(255,255,255,.14); color: rgba(255,255,255,.88); font-size: 23rpx; line-height: 56rpx; font-weight: 600; }
.review-links { height: 72rpx; margin-top: 16rpx; border-top: 1rpx solid rgba(255,255,255,.2); display: grid; grid-template-columns: 1fr 1rpx 1fr; align-items: center; }
.review-links view { width: 1rpx; height: 28rpx; background: rgba(255,255,255,.22); }
.review-links button { width: 100% !important; height: 72rpx; padding: 0; background: transparent; color: rgba(255,255,255,.9); font-size: 24rpx; line-height: 34rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.action-grid { width: 100%; margin-top: 24rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.home-action { width: 100% !important; min-width: 0; height: 144rpx; padding: 24rpx 18rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: #fff; display: grid; grid-template-columns: 64rpx minmax(0, 1fr); align-items: center; column-gap: 14rpx; text-align: left; overflow: hidden; }
.home-action-icon { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--apricot); display: flex; align-items: center; justify-content: center; }
.translate-action .home-action-icon { background: #eaf3ff; color: #0967e8; font-weight: 800; }
.home-action-icon image { width: 32rpx; height: 32rpx; }
.home-action-copy { min-width: 0; width: 100%; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 6rpx; overflow: hidden; }
.home-action-copy text:first-child { color: var(--ink); font-size: 27rpx; line-height: 38rpx; font-weight: 600; }
.home-action-copy text:last-child { max-width: 100%; color: var(--muted); font-size: 20rpx; line-height: 28rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.book-copy { flex: 1; display: flex; flex-direction: column; }
.book-copy text:first-child { color: var(--ink); font-size: 30rpx; line-height: 42rpx; font-weight: 600; }
.book-copy text:last-child { margin-top: 4rpx; color: var(--muted); font-size: 24rpx; line-height: 34rpx; }
.section-head { margin: 44rpx 0 16rpx; min-height: 56rpx; display: flex; align-items: center; justify-content: space-between; }
.section-link { color: var(--blue); font-size: 25rpx; font-weight: 600; }
.check-strip { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.check-day { min-width: 0; min-height: 128rpx; padding: 12rpx 0; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--subtle); gap: 6rpx; }
.check-day text:nth-child(2) { font-weight: 700; color: #243248; }
.check-day.checked { background: #eaf3ff; color: #0969ed; }
.dot { width: 24rpx; height: 24rpx; }
.book-list { border-top: 0; }
.book-row { width: 100% !important; min-width: 0; max-width: none; min-height: 144rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); background: #fff; display: flex; align-items: center; text-align: left; }
.book-icon { width: 88rpx; height: 88rpx; margin-right: 24rpx; border-radius: 26rpx; background: #edf4ff; color: #0967e8; font-size: 36rpx; display: flex; align-items: center; justify-content: center; }
.book-icon image { width: 40rpx; height: 40rpx; }
