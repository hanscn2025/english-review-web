.translate-page { padding: 8rpx 48rpx calc(64rpx + env(safe-area-inset-bottom)); }
.language-row { width: 100%; height: 104rpx; box-sizing: border-box; border-bottom: 1rpx solid var(--line); display: grid; grid-template-columns: minmax(0, 1fr) 72rpx minmax(0, 1fr); align-items: center; color: var(--text); font-size: 27rpx; line-height: 38rpx; font-weight: 600; }
.language-row picker { min-width: 0; }
.language-choice { width: 100%; min-width: 0; height: 72rpx; box-sizing: border-box; padding: 0 8rpx; display: flex; align-items: center; gap: 6rpx; }
.language-choice text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.language-choice image { flex: 0 0 22rpx; width: 22rpx; height: 22rpx; transform: rotate(90deg); }
.language-choice.target { justify-content: flex-end; text-align: right; }
.swap-language { width: 72rpx !important; height: 72rpx; padding: 0; border-radius: 36rpx; background: transparent; display: flex; align-items: center; justify-content: center; }
.swap-language image { width: 30rpx; height: 30rpx; }
.translate-box { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid var(--line); border-radius: 32rpx; background: #fff; }
.source { width: 100%; min-height: 240rpx; color: var(--ink); font-size: 32rpx; font-weight: 400; line-height: 1.6; }
.input-tools { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f4; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 8rpx; }
.input-tools.has-source { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.input-tools button { width: 100%; height: 72rpx; padding: 0 6rpx; border-radius: 18rpx; color: var(--muted); font-size: 23rpx; line-height: 32rpx; white-space: nowrap; display: flex; align-items: center; justify-content: center; gap: 7rpx; }
.input-tools button image { flex: 0 0 auto; width: 26rpx; height: 26rpx; }
.tool { background: transparent; }
.tool.active { background: #fff0e5; color: #ac5420; }
.speaker-tool { background: transparent; }
.clear-tool,.history-tool { background: transparent; }
.result-head image { width: 100%; height: 100%; }
.status,.error { margin-top: 18rpx; font-size: 25rpx; line-height: 1.5; }.status { color: #667085; }.error { color: #b54732; }
.translate-button { width: 100% !important; margin-top: 28rpx; }
.result-card { margin-top: 28rpx; padding: 32rpx; border: 1rpx solid #dbeafe; border-radius: 32rpx; background: var(--blue-soft); }
.result-head { display: flex; align-items: center; justify-content: space-between; color: #647187; font-size: 25rpx; }.result-head button { width: 68rpx; height: 68rpx; padding: 16rpx; border-radius: 34rpx; background: #fff; }
.translation { margin-top: 18rpx; color: #132033; font-size: 34rpx; line-height: 1.65; }
.save-entry { min-height: 80rpx; margin-top: 28rpx; padding: 0; background: transparent; color: var(--blue); font-size: 27rpx; font-weight: 700; display: flex; align-items: center; gap: 10rpx; text-align: left; }
.save-entry image { width: 28rpx; height: 28rpx; }
