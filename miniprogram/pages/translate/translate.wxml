<view class="page translate-page">
  <view class="mini-topbar"><view class="bar-side"></view><view class="bar-title">在线翻译</view><view class="bar-side"></view></view>
  <view class="language-row">
    <picker mode="selector" range="{{languages}}" value="{{sourceIndex}}" bindchange="chooseSource"><view class="language-choice"><text>{{languages[sourceIndex]}}</text><image src="/assets/icons/chevron-right.svg" /></view></picker>
    <button class="swap-language" bindtap="swapLanguages" aria-label="交换语言"><image src="/assets/icons/swap.svg" /></button>
    <picker mode="selector" range="{{languages}}" value="{{targetIndex}}" bindchange="chooseTarget"><view class="language-choice target"><text>{{languages[targetIndex]}}</text><image src="/assets/icons/chevron-right.svg" /></view></picker>
  </view>
  <view class="translate-box">
    <textarea class="source" auto-height value="{{source}}" bindinput="inputSource" placeholder="输入要翻译的内容" maxlength="1000" focus />
    <view class="input-tools {{source ? 'has-source' : ''}}">
      <button class="tool" bindtap="scanImage" disabled="{{working}}"><image class="tool-icon" src="/assets/icons/camera.svg" /><text>拍照</text></button>
      <button wx:if="{{source}}" class="speaker-tool" bindtap="speakSource" disabled="{{speaking}}"><image src="/assets/icons/volume-muted.svg" /><text>朗读</text></button>
      <button wx:if="{{source}}" class="clear-tool" bindtap="clearSource" disabled="{{working}}"><image src="/assets/icons/close.svg" /><text>清空</text></button>
      <button class="history-tool" bindtap="showHistory"><image src="/assets/icons/history.svg" /><text>历史</text></button>
    </view>
  </view>
  <view class="status" wx:if="{{status}}">{{status}}</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button class="primary translate-button" bindtap="translate" loading="{{translating}}" disabled="{{!source || working}}">翻译</button>
  <view class="result-card" wx:if="{{translation}}">
    <view class="result-head"><text>翻译结果</text><button bindtap="speakTranslation"><image src="/assets/icons/volume-muted.svg" /></button></view>
    <view class="translation">{{translation}}</view>
    <button class="save-entry" bindtap="saveToBook"><image src="/assets/icons/plus.svg" />收录到词书</button>
  </view>
</view>
