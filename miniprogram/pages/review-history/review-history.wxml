<view class="page history-page">
  <view class="mini-topbar"><view class="bar-side"><button bindtap="goBack"><image src="/assets/icons/back.svg" /></button></view><view class="bar-title">复习中心</view><view class="bar-side"></view></view>
  <view class="history-tabs"><button class="{{tab === 'history' ? 'selected' : ''}}" data-tab="history" bindtap="selectTab">复习回顾</button><button class="{{tab === 'free' ? 'selected' : ''}}" data-tab="free" bindtap="selectTab">自由复习</button></view>
  <view wx:if="{{tab === 'history'}}" class="history-list">
    <view wx:for="{{logs}}" wx:key="_id" class="history-row"><view><text>{{item.entry.english}}</text><text>{{item.entry.meaning}}</text></view><text class="result {{item.rating}}">{{item.result}}</text></view>
    <view wx:if="{{!loading && !logs.length}}" class="empty">完成一次复习后，记录会出现在这里。</view>
  </view>
  <view wx:else>
    <button wx:if="{{entries.length}}" class="primary review-all" bindtap="reviewAll">复习全部内容</button>
    <view class="history-list"><view wx:for="{{entries}}" wx:key="_id" class="history-row"><view><text>{{item.english}}</text><text>{{item.meaning}}</text></view><button class="review-one" data-id="{{item._id}}" bindtap="reviewEntry">再复习</button></view></view>
    <view wx:if="{{!loading && !entries.length}}" class="empty">词书里还没有可以复习的内容。</view>
  </view>
</view>
