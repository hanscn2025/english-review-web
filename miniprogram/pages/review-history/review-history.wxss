.history-page { padding: 8rpx 48rpx calc(48rpx + env(safe-area-inset-bottom)); }
.history-tabs { height: 96rpx; box-sizing: border-box; margin: 12rpx 0 24rpx; padding: 6rpx; border-radius: 24rpx; background: var(--surface); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; }
.history-tabs button { width: 100% !important; height: 84rpx; padding: 0; border-radius: 19rpx; background: transparent; color: var(--muted); font-size: 27rpx; line-height: 38rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.history-tabs button.selected { background: #fff; color: var(--blue); box-shadow: 0 4rpx 14rpx rgba(16,24,40,.06); }
.history-list { border-top: 1rpx solid var(--line); }
.history-row { min-height: 144rpx; box-sizing: border-box; padding: 24rpx 4rpx; border-bottom: 1rpx solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.history-row > view { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.history-row > view text:first-child { color: var(--ink); font-size: 30rpx; line-height: 42rpx; font-weight: 600; }
.history-row > view text:last-child { color: var(--muted); font-size: 24rpx; line-height: 34rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result { flex: 0 0 auto; min-width: 72rpx; box-sizing: border-box; padding: 8rpx 16rpx; border-radius: 14rpx; background: var(--blue-soft); color: var(--blue); font-size: 23rpx; line-height: 32rpx; text-align: center; }
.result.again { background: var(--apricot); color: #b45309; }
.review-all { width: 100% !important; margin-bottom: 28rpx; }
.review-one { flex: 0 0 144rpx; width: 144rpx !important; height: 72rpx; padding: 0 20rpx; border-radius: 18rpx; background: var(--blue-soft); color: var(--blue); font-size: 25rpx; line-height: 36rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
