.review { min-height: 100vh; padding: 0 48rpx; display: flex; flex-direction: column; }
.review-nav { margin: 0; }
.review-nav .bar-side.right { color: #667085; font-size: 26rpx; font-weight: 700; }
.progress { height: 6rpx; border-radius: 3rpx; background: #e8edf3; overflow: hidden; }
.progress view { height: 100%; background: #0967e8; }
.question-stage { display: flex; flex: 1; min-height: 0; flex-direction: column; justify-content: flex-start; padding: 32rpx 0 calc(32rpx + env(safe-area-inset-bottom)); }
.question-card { min-height: 440rpx; box-sizing: border-box; padding: 32rpx; border: 1rpx solid var(--line); border-radius: 32rpx; background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%); display: flex; flex-direction: column; }
.card-meta { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 24rpx; line-height: 34rpx; }
.card-meta text:first-child { padding: 6rpx 14rpx; border-radius: 12rpx; background: var(--blue-soft); color: var(--blue); font-weight: 600; }
.prompt { margin-top: 32rpx; color: var(--muted); font-size: 26rpx; line-height: 38rpx; font-weight: 600; }
.word-line { margin-top: 28rpx; display: flex; align-items: center; gap: 16rpx; }
.english { min-width: 0; color: var(--blue); font-size: 56rpx; line-height: 1.3; font-weight: 700; overflow-wrap: anywhere; }
.inline-speaker { flex: 0 0 72rpx; width: 72rpx !important; height: 72rpx; padding: 0; border-radius: 36rpx; background: var(--blue-soft); display: flex; align-items: center; justify-content: center; }
.inline-speaker image { width: 34rpx; height: 34rpx; }
.question-ipa { margin-top: 8rpx; color: var(--muted); font-size: 26rpx; line-height: 38rpx; }
.context { position: relative; margin-top: 32rpx; padding: 24rpx 72rpx 24rpx 24rpx; border-radius: 22rpx; background: #fff4e8; color: var(--text); }
.context > text { color: #9a5614; font-size: 22rpx; line-height: 32rpx; font-weight: 600; }
.context > view { margin-top: 8rpx; font-size: 27rpx; line-height: 42rpx; }
.context button { position: absolute; top: 50%; right: 12rpx; width: 56rpx; height: 56rpx; padding: 0; transform: translateY(-50%); background: transparent; display: flex; align-items: center; justify-content: center; }
.context button image { width: 30rpx; height: 30rpx; }
.book-note { margin-top: auto; padding-top: 28rpx; color: var(--subtle); font-size: 23rpx; line-height: 34rpx; }
.speech-error { margin-top: 12rpx; color: #b54732; font-size: 24rpx; line-height: 36rpx; }
.question-actions { margin-top: 28rpx; }
.action-hint { margin-bottom: 16rpx; color: var(--subtle); font-size: 22rpx; line-height: 34rpx; text-align: center; }
.quick-ratings { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.quick-ratings button { width: 100% !important; min-width: 0; }
.review-choice { height: 96rpx; padding: 0 20rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: #fff; color: var(--text); font-size: 28rpx; line-height: 40rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.review-choice:active { background: var(--surface); }
.answer { display: flex; flex: 1; flex-direction: column; }
.divider { margin: 30rpx 0 48rpx; border-top: 1rpx solid #e6eaf0; }
.answer-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.answer-word { min-width: 0; display: flex; align-items: center; gap: 14rpx; }
.answer-word > text { min-width: 0; color: var(--ink); font-size: 52rpx; line-height: 68rpx; font-weight: 700; overflow-wrap: anywhere; }
.answer-word button { flex: 0 0 64rpx; width: 64rpx !important; height: 64rpx; padding: 0; border-radius: 32rpx; background: var(--blue-soft); display: flex; align-items: center; justify-content: center; }
.answer-word button image { width: 32rpx; height: 32rpx; }
.answer-heading text:last-child { margin-top: 10rpx; padding: 8rpx 16rpx; border-radius: 12rpx; background: var(--blue-soft); color: var(--blue); font-size: 22rpx; font-weight: 700; }
.ipa-row { color: #657286; font-size: 26rpx; line-height: 38rpx; }
.meaning { margin-top: 12rpx; color: var(--text); font-size: 34rpx; font-weight: 600; line-height: 1.6; }
.example-zh { margin-top: 34rpx; color: #344054; line-height: 1.65; }
.example-zh text { color: #98a2b3; font-size: 24rpx; }.example-zh view { margin-top: 14rpx; font-size: 28rpx; }
.ratings { margin-top: auto; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.ratings button { width: 100% !important; min-width: 0; border-radius: 16rpx; }
.action-note { margin: 16rpx 0 0; padding-bottom: env(safe-area-inset-bottom); color: #98a2b3; font-size: 22rpx; text-align: center; }
