.header-row { min-height: 116rpx; display: flex; align-items: center; justify-content: space-between; }
.header-row .title { margin: 0; font-size: 34rpx; }
.add { width: 104rpx; height: 104rpx; padding: 0; border-radius: 52rpx; background: transparent; color: #111827; font-size: 46rpx; display: flex; align-items: center; justify-content: center; }
.inline-form { width: 100%; min-width: 0; box-sizing: border-box; margin: 8rpx 0 28rpx; display: grid; grid-template-columns: minmax(0, 1fr) 136rpx; gap: 16rpx; overflow: hidden; }
.inline-form .input,.inline-form button { width: 100% !important; min-width: 0; min-height: 96rpx; box-sizing: border-box; }
.inline-form button { padding: 0 12rpx; border-radius: 24rpx; background: var(--blue); color: #fff; font-size: 28rpx; line-height: 40rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; white-space: nowrap; }
.books { margin-top: 12rpx; border: 1rpx solid var(--line); border-radius: 32rpx; overflow: hidden; }
.book { width: 100% !important; min-width: 0; max-width: none; min-height: 144rpx; padding: 20rpx 24rpx; background: #fff; border-bottom: 1rpx solid var(--line); display: flex; align-items: center; text-align: left; }
.book:last-child { border-bottom: 0; }
.book-cover { width: 88rpx; height: 88rpx; margin-right: 24rpx; border-radius: 26rpx; background: #edf4ff; display: flex; align-items: center; justify-content: center; }
.book-cover image { width: 40rpx; height: 40rpx; }
.cover-1 { background: #fff0e5; }.cover-2 { background: #eef1f6; }
.copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.copy text:first-child { color: var(--ink); font-size: 30rpx; line-height: 42rpx; font-weight: 600; }
.copy text:last-child { margin-top: 4rpx; color: var(--muted); font-size: 24rpx; line-height: 34rpx; }
.quiet-tip { margin: 48rpx 0; color: #98a2b3; font-size: 24rpx; text-align: center; }
.books-page { width: 100%; max-width: 100vw; padding: 8rpx 48rpx 48rpx; overflow-x: hidden; }
.create-action { width: 100% !important; height: 88rpx; margin: 8rpx 0 24rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--surface); color: var(--blue); font-size: 27rpx; line-height: 38rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.create-action image { width: 28rpx; height: 28rpx; }
