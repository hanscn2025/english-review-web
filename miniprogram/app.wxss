page {
  --blue: #2563eb;
  --blue-strong: #1d4ed8;
  --blue-soft: #eff6ff;
  --ink: #101828;
  --text: #344054;
  --muted: #667085;
  --subtle: #98a2b3;
  --line: #e4e7ec;
  --surface: #f8fafc;
  --apricot: #fff1e6;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --control-sm: 72rpx;
  --control-md: 88rpx;
  --control-lg: 96rpx;
  background: #fff;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
}

button { box-sizing: border-box; min-width: 0; max-width: none; margin: 0; line-height: 1.35; }
button::after { border: 0; }
.mini-topbar { position: relative; box-sizing: border-box; min-height: 224rpx; padding-top: 112rpx; display: grid; grid-template-columns: 96rpx 1fr 160rpx; align-items: center; }
.mini-topbar .bar-title { position: absolute; left: 50%; bottom: 24rpx; max-width: 320rpx; transform: translateX(-50%); overflow: hidden; color: var(--ink); font-size: 34rpx; font-weight: 600; line-height: 48rpx; letter-spacing: 0; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.mini-topbar .bar-side { min-width: 104rpx; min-height: 104rpx; display: flex; align-items: center; }
.mini-topbar .bar-side.right { justify-content: flex-start; }
.mini-topbar button { width: 96rpx; height: 96rpx; padding: 0; background: transparent; color: var(--ink); font-size: 44rpx; display: flex; align-items: center; justify-content: center; }
.mini-topbar button image { width: 36rpx; height: 36rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 48rpx 48rpx; background: #fff; }
.eyebrow { color: var(--blue); font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { margin: 12rpx 0 0; font-size: 48rpx; line-height: 1.25; font-weight: 700; }
.section-title { color: var(--ink); font-size: 32rpx; line-height: 44rpx; font-weight: 700; }
.muted { color: var(--muted); }
.card { background: #fff; border: 1rpx solid var(--line); border-radius: 32rpx; }
.primary { display: flex; align-items: center; justify-content: center; min-height: var(--control-lg); padding: 0 32rpx; border-radius: 24rpx; background: var(--blue); color: #fff; font-size: 30rpx; line-height: 42rpx; font-weight: 700; }
.primary[disabled] { background: #e4e7ec; color: #98a2b3; }
.secondary { display: flex; align-items: center; justify-content: center; min-height: var(--control-lg); padding: 0 28rpx; border: 2rpx solid var(--blue); border-radius: 24rpx; background: #fff; color: var(--blue); font-size: 30rpx; line-height: 42rpx; font-weight: 600; }
.field { margin-top: 30rpx; }
.field-label { display: block; margin-bottom: 14rpx; color: var(--ink); font-size: 28rpx; line-height: 40rpx; font-weight: 600; }
.input, .textarea, .picker { width: 100%; box-sizing: border-box; border: 1rpx solid #d0d5dd; border-radius: 24rpx; background: #fff; padding: 24rpx 28rpx; color: var(--ink); font-size: 30rpx; line-height: 1.5; }
.input, .picker { min-height: 96rpx; }
.textarea { min-height: 150rpx; }
.empty { padding: 120rpx 24rpx; color: var(--muted); font-size: 26rpx; line-height: 40rpx; text-align: center; }
.row-arrow { color: var(--subtle); font-size: 34rpx; line-height: 1; }
.row-icon { flex: 0 0 auto; width: 28rpx; height: 28rpx; }
